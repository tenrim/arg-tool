        },
        {
          "Book": "《唐诗解》",
          "Section": null,
          "Content": "摹写静夜之景，字字真率，正济南所谓“不用意得之”者。",
          "IsComment": false,
          "ReferrenceUrls": null,
          "FullPath": "《唐诗解》"
        },
        {
          "Book": "《增订唐诗摘钞》",
          "Section": null,
          "Content": "思乡诗最多，终不如此四语真率而有味。此信口语，后人复不能摹拟，摹拟便丑，语似极率，回环尽致。",
          "IsComment": false,
