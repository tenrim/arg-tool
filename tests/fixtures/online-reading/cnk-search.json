        {
          "Book": "《增订评注唐诗正声》",
          "Section": null,
          "Content": "郭云：悄悄冥冥，千古旅情，尽此十字（末二句下）。",
          "IsComment": false,
          "ReferrenceUrls": null,
          "FullPath": "《增订评注唐诗正声》"
        },
        {
          "Book": "《李杜诗选》",
          "Section": null,
          "Content": "范德机曰：五言短古，不可明白说尽，含糊则有余味，如此篇也。",
          "IsComment": false,
          "ReferrenceUrls": null,
          "FullPath": "《李杜诗选》"
