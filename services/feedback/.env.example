SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
REPORT_TO=
# Exact public origin, without a trailing slash. Separate multiple origins by commas.
ALLOWED_ORIGINS=http://localhost:3000
# Unified root npm start: optional exact direct reverse-proxy IPs, comma-separated.
# Leave blank for direct connections. No hostnames, CIDR ranges or wildcards.
# Only listed peers may supply one X-Real-IP; X-Forwarded-For is never trusted.
FEEDBACK_TRUSTED_PROXIES=
# HOST / PORT / TRUST_PROXY below apply only to standalone services/feedback npm start.
# Unified root npm start keeps the existing website port and uses a private random mail port.
HOST=127.0.0.1
PORT=6143
# Only enable behind a trusted local reverse proxy that overwrites X-Real-IP.
TRUST_PROXY=false
