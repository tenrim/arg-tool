# Copy to repository root .env.bot-tools (ignored by Git).
# Generate an independent token; do not reuse any existing password.
BOT_TOOLS_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARS
BOT_TOOLS_HOST=127.0.0.1
BOT_TOOLS_PORT=3216
BOT_TOOLS_CONCURRENCY=2
BOT_TOOLS_TIMEOUT_MS=30000
BOT_TOOLS_SITE_URL=http://localhost:3000/
# Empty: serve the existing public assets on a private loopback port.
BOT_TOOLS_RESOURCE_BASE=
# Optional absolute path to an installed Chromium executable.
BOT_TOOLS_CHROMIUM_PATH=
