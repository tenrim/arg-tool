# Python maintenance scripts may produce local bytecode.
__pycache__/
*.py[cod]

# Reproducible expansion browser fixtures/downloads; never release user media.
.tmp-expansion-tests/

# Local Android toolchains, staging assets, test keys and APK artifacts.
/outputs/apk-build/
/outputs/android-signing/
/outputs/android-signing-backup/
/outputs/android-release/

# Local reference repositories and XERJ state (not product dependencies).
/.reference-code/

# Isolated Python formatting tool (development only).
/tools/format/python/

# Local diagnostics are never repository source.
/debug.log

# Explicit code-runner compiler downloads; provenance stays in ARTIFACTS.json.
/services/code-runner/kotlin-lib/
/services/code-runner/*.tgz
/services/code-runner/*.deb
/services/code-runner/*.part

