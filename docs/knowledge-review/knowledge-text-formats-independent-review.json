  "findings": [
    {
      "articleId": "function-pair:AMF%20Encode",
      "severity": "high",
      "initialProblem": "AMF3 true 的规范字节03被当作工具实例，但实际上游Value.any(true)失败。",
      "observed": "AMF3 true: Cannot set property value of #<fc> which has only a getter；AMF0 true: 01 01 成功；AMF3 {\"a\":1}: 0a 13 01 03 61 05 3f f0 00 00 00 00 00 00 成功。",
      "rootCause": "规范支持的类型与固定版本AMF库支持的具体输入不一致。",
      "fix": "保留规范AMF3布尔标记知识，但标签明确格式演算；更好再给可执行AMF0 true→01 01 或已验证AMF3对象例子。不得靠变更内核掩盖文献与实现差异。",
      "currentReview": "文章已把该例子标明AMF3规范/格式演算；不再直接声称真实Worker输出03。"
    },
    {
      "articleId": "function-op:Series%20chart",
      "severity": "high",
      "initialProblem": "一列数值例子无法被实际系列图解析；正文未明确三字段输入和分类X轴。",
      "observed": "1\n3\n2\n4 报 Each row must have length 3；s t1 1\ns t2 3\ns t3 2\ns t4 4 生成SVG。",
      "rootCause": "getSeriesValues 强制 [系列名,X标签,Y数值]；同系列同X后值覆盖；scalePoint按X首次出现顺序等距排布。",
      "fix": "用三字段实测例子，具体解释列角色、重复X覆盖、横轴并非按数值/时间比例。加 Charts.mjs 与 SeriesChart.mjs 原始实现近旁来源。",
      "currentReview": "已改并准确描述三字段、分类轴及覆盖规则。"
    },
    {
      "articleId": "function-op:Chi%20Square",
      "severity": "high",
      "initialProblem": "用标准Pearson全部256类公式解释固定内核只计非零类的分数。",
      "observed": "AAB 原内核=420.69010416666663；完整256类均匀χ²=423.6666666666667。",
      "rootCause": "ChiSquare.mjs 使用 if(distArray[i]>0) 跳过零观测类，它们原本仍有E=N/256>0并应产生贡献。",
      "fix": "区分规范公式和固定版本实现分数，加两数对照、短样本适用性和实际源码引用。",
      "currentReview": "已改，明确标准与固定v11.5.0差异，未擅改原内核。"
    },
    {
      "articleId": "function-op:Add%20line%20numbers",
      "severity": "medium",
      "initialProblem": "示例用冒号分隔且Offset起点不准确。",
      "observed": "Offset=0 输出 1 alpha\n2 beta；Offset=1 输出2 alpha\n3 beta。",
      "rootCause": "编号为行索引+1+Offset，按总行数十进制位宽左补空格，再追加单个空格，无冒号。",
      "fix": "给真实Offset=0输出，写清编号公式、空行也计数、固定分隔样式。",
      "currentReview": "已改，示例与固定规则准确。"
    },
    {
      "articleId": "function-op:HTML%20To%20Text",
      "severity": "high",
      "initialProblem": "误写从HTML提取正文，示例<strong>KEY</strong>→KEY不成立。",
      "observed": "原输入<strong>KEY</strong>输出仍为<strong>KEY</strong>。",
      "rootCause": "HTMLToText.run直接return input，仅将html Dish输出类型转成string，不解析DOM或删除标签。",
      "fix": "正文改为HTML源码转普通字符串显示，保留标签。去标签引导到Strip HTML tags，加官方固定源码。",
      "currentReview": "已改准确，源码保持原样的例子也准确。"
    },
    {
      "articleId": "function-op:P-list%20Viewer",
      "severity": "high",
      "initialProblem": "一般plist规范与当前XML正则查看器混淆，暗示binary支持；示例缺plist根。",
      "observed": "旧<dict>片段输出>\n。合法多行输入<?xml version=\"1.0\"?>\n<plist version=\"1.0\">\n<dict>\n<key>clue</key>\n<string>KEY</string>\n</dict>\n</plist>输出plist => {\n\tclue => \"KEY\"\n}\n/plist\n。",
      "rootCause": "固定官方ChefWorker的同名run先slice(indexOf(\"<plist\"))，再用regex替换标签并缩进；不是完整XML或binary plist解析器。",
      "fix": "一般plist可有XML/binary的知识保留，但工具行为明确仅XML文本、须完整根及多行；替换为实测例子。引用本地官方ChefWorker同名run，原源文件路径未确认不得编造。",
      "currentReview": "root已收到实际成功输出与固定规则；此QA不修改分片，最后检查时尚待root落实。"
    },
    {
      "articleId": "function-op:Reverse",
      "severity": "medium",
      "initialProblem": "每个8位单元独立反转的表述容易误读为反转每个字节内部bit。",
      "observed": "Byte模式输入AB实际输出字节42 41，即BA；每个字节内部的位不改变。",
      "rootCause": "Byte分支对字节数组调用reverse()，并非Reverse bits操作。",
      "fix": "改成按八位字节单元的排列倒序，字节内部8位保持原样；字符与行单位分别解释。",
      "currentReview": "已通知root，最后检查时该句尚待调整。"
    }
  ],
