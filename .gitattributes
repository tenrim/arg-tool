# Auto detect text files and perform LF normalization
* text=auto eol=lf
# Pinned runtime/source bytes are checked against upstream SHA-256 manifests.
public/vendor/** -text
upstream/** -text
public/licenses/** -text
public/fonts/** -text

# Importer source hashes must survive archive/checkout byte-for-byte.
scripts/** -text whitespace=cr-at-eol
